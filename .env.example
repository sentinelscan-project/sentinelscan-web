# --- SentinelScan Web (frontend) configuration -------------------------------
# Only public, non-secret values belong here: everything prefixed with
# NEXT_PUBLIC_ is inlined into the browser bundle at build time.
#
# Backend secrets (JWT_SECRET, DATABASE_URL, GOOGLE_CLIENT_SECRET, ZAP_API_KEY, GEMINI_API_KEY)
# belong to sentinelscan-api and must never be set in this project.

# Base URL of the sentinelscan-api service.
#   local development: http://localhost:4000
#   deployed API:      https://sentinelscan-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000
